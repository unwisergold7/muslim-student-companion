# Supabase Configuration
#
# To connect your app to Supabase:
#   1. Copy this file:  cp .env.local.example .env.local
#   2. Replace the placeholder values with your real credentials
#   3. Get them from: Supabase Dashboard → Settings → API
#   4. Restart the dev server after saving
#
# The app works WITHOUT these — it falls back to local data files.

# Client-side (used by the app in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (used by the seed script — NEVER exposed to the browser)
# Get this from: Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Debug mode — disable local data fallback to verify Supabase is working
# Set to "true" to force Supabase-only mode (empty data if Supabase fails)
# Leave unset or "false" for normal fallback behaviour
# NEXT_PUBLIC_DISABLE_LOCAL_FALLBACK=true
